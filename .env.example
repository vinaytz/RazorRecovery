# RazorRecovery -- example environment.
#
#   cp .env.example .env
#
# NOTHING HERE IS REQUIRED. The whole stack runs on a fresh clone with no .env
# at all: `docker compose up` builds, runs the benchmark, and serves the
# dashboard. Every variable below is optional, and every one of them degrades
# LOUDLY rather than silently -- the Ops tab tells you exactly what is missing
# and what that costs, and `GET /api/ops/live-readiness` says the same thing in
# JSON.
#
# There are no real secrets in this file and there never were any in this
# repository's history. `.env` is gitignored.

# -- the safety switch -------------------------------------------------------

# true  (default): no message and no payment link leaves the process. Contacts
#                  are counted, settlements attribute as SELF_RECOVERED, and
#                  attribution declines to claim causality for an email nobody
#                  received. This is the default in code, in the Dockerfile and
#                  in compose, deliberately.
# false          : actually send. Only meaningful with SMTP and/or Razorpay
#                  credentials below -- without them, flipping this changes
#                  almost nothing, and the confirm step says so instead of
#                  telling you that you are now live.
DRY_RUN=true

# -- the live worker ---------------------------------------------------------

# on (default): the recovery loop ticks. off: dashboard and API only. A
# recovery engine whose worker is opt-in is a recovery engine that does nothing
# on a fresh clone, so it is on by default.
WORKER=on

# Where sqlite lives. In Docker this points at the /data volume and you should
# not need to change it. Outside Docker it defaults to ./razorrecovery.db.
# RAZORRECOVERY_DB=/data/razorrecovery.db

# -- Razorpay ----------------------------------------------------------------
# Without these: payment links stay stubs. The engine still decides to send one,
# still records the action and still scores the outcome -- it just never calls
# the API. Nothing crashes and nothing is silently skipped.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Not the same value as RAZORPAY_KEY_SECRET. Without it, POST /webhooks/razorpay
# still accepts events but the response carries an explicit warning that the
# signature was NOT checked -- an unverified webhook is accepted knowingly, not
# accidentally. Set it and the signature is verified on the raw body, before
# JSON parsing.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Cosmetic: the name that appears on generated payment links.
MERCHANT_NAME=Your Merchant Name
# Which merchant the live worker ingests for. Defaults to merchant_1.
MERCHANT_ID=merchant_1

# -- email -------------------------------------------------------------------
# Without these: reminders are counted, not sent. The Ops tab reads
# "no SMTP_HOST/SMTP_FROM -- emails are counted, not sent" rather than
# reporting a successful send that never happened.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=you@example.com
SMTP_FROM_NAME=RazorRecovery
SMTP_TLS=true

# -- the LLM -----------------------------------------------------------------
# stub (default) is not a degraded mode. It is a keyword classifier that the
# benchmark runs on, so the numbers in README.md do not depend on a model being
# reachable. Set LLM_MODE=gemini WITH a key to use Gemini for error
# classification; with the mode set and no key, it falls back to the stub and
# says so. Press "kill LLM" on the dashboard to watch decisions keep flowing
# either way -- the LLM never returns a money action.
LLM_MODE=stub
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -- demo knobs --------------------------------------------------------------
# These exist so a live demo does not run in real time. They affect the live
# worker only. tests/test_live_worker.py pins that setting them to absurd values
# leaves the benchmark output byte-identical -- the benchmark runs on a virtual
# clock and cannot see them.
#
# TIME_SCALE=60           1 real minute becomes 1 simulated hour
# ABANDON_MINUTES=2       how long a checkout sits before it counts as abandoned
# STALE_DOWNTIME_HOURS=6  an outage with no .resolved after this long is shown
#                         as STALLED on the Ops tab. It is NOT auto-expired: a
#                         gate that stops blocking because a clock ran out is a
#                         gate that stopped being evidence.
